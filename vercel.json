{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --prefix website",
  "buildCommand": "npm run build --prefix website",
  "outputDirectory": "website/dist",
  "trailingSlash": true,
  "redirects": [{ "source": "/docs/", "destination": "/docs/quickstart/", "permanent": false }],
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- website docs pyproject.toml vercel.json",
  "headers": [
    {
      "source": "/_astro/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
