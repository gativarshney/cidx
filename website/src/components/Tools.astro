---
import demo from '../data/demo.json';
import { tint } from '../util/tint';

const firstRow = (text: string) => text.split('\n')[0];
const { mcp } = demo;
const tools = [
	{ name: 'search_symbols', signature: 'query', ask: 'You only roughly know a name.', call: 'search_symbols("pass_cont")', row: firstRow(mcp.search.text) },
	{ name: 'find_definition', signature: 'name', ask: 'Where is this defined?', call: 'find_definition("Context.invoke")', row: firstRow(mcp.definition.text) },
	{ name: 'find_references', signature: 'name', ask: 'Who uses this?', call: 'find_references("echo")', row: firstRow(mcp.references.text) },
	{ name: 'outline_file', signature: 'path', ask: 'What is in this file?', call: 'outline_file("src/click/globals.py")', row: mcp.outlineSmall.text.split('\n')[4] },
	{ name: 'repo_map', signature: '', ask: 'What does this repository look like?', call: 'repo_map()', row: firstRow(mcp.repoMap.text) },
];
---

<ul class="tools">
	{tools.map((tool, index) => (
		<li data-reveal data-glow style={`transition-delay: ${index * 60}ms`}>
			<p class="ask">{tool.ask}</p>
			<h3>
				{tool.name}<span>({tool.signature})</span>
			</h3>
			<div class="sample">
				<p class="call">{tool.call}</p>
				<pre set:html={tint(tool.row)} />
			</div>
		</li>
	))}
	<li class="contract" data-reveal style="transition-delay: 300ms">
		<p class="ask">Every response</p>
		<h3>The same contract</h3>
		<ul>
			<li><code>path:line</code> and a signature, never file bodies</li>
			<li><code>max_tokens</code> budget, default 700</li>
			<li><code>truncated: true, total_matches: N</code> when cut</li>
			<li><code>index_age_ms</code> freshness stamp</li>
			<li>on a miss: says so, recommends grep</li>
		</ul>
	</li>
</ul>

<style>
	.tools {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1rem;
	}

	.tools > li {
		display: flex;
		flex-direction: column;
		min-width: 0;
		padding: 1.25rem;
		border: 1px solid var(--line);
		border-radius: 16px;
		background: var(--bg-raised);
		transition:
			border-color 0.2s,
			opacity 0.7s ease,
			transform 0.7s cubic-bezier(0.2, 0.7, 0.2, 1);
	}

	.tools > li:hover {
		border-color: var(--line-strong);
	}

	.ask {
		font-size: 0.88rem;
		color: var(--muted);
	}

	h3 {
		margin-top: 0.3rem;
		font-family: var(--font-mono);
		font-size: 1.02rem;
		font-weight: 600;
	}

	h3 span {
		color: var(--muted);
		font-weight: 400;
	}

	.sample {
		margin-top: auto;
		padding-top: 1.1rem;
		font-family: var(--font-mono);
		font-size: 0.7rem;
		line-height: 1.6;
	}

	.call {
		color: var(--accent);
	}

	.call::before {
		content: '> ';
		color: var(--muted);
	}

	pre {
		margin-top: 0.3rem;
		padding: 0.6rem 0.75rem;
		border-radius: 8px;
		background: var(--bg-sunken);
		border: 1px solid var(--line);
		color: var(--text-soft);
		white-space: pre-wrap;
		overflow-wrap: anywhere;
	}

	.contract {
		border-style: dashed !important;
		background: transparent !important;
	}

	.contract h3 {
		font-family: var(--font-sans);
	}

	.contract ul {
		margin-top: 0.9rem;
		display: grid;
		gap: 0.45rem;
		font-size: 0.86rem;
		color: var(--text-soft);
	}

	.contract ul li {
		padding-left: 1rem;
		position: relative;
	}

	.contract ul li::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0.6em;
		width: 5px;
		height: 5px;
		border-radius: 50%;
		background: var(--exact);
	}

	.contract code {
		font-size: 0.82em;
		color: var(--text);
	}

	@media (max-width: 960px) {
		.tools {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 620px) {
		.tools {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
