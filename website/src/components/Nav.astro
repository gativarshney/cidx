---
import { href } from '../util/site';

const links = [
	{ label: 'Setup', to: href('/#connect') },
	{ label: 'Demo', to: href('/#demo') },
	{ label: 'How it works', to: href('/#how') },
	{ label: 'Benchmarks', to: href('/#numbers') },
	{ label: 'Docs', to: href('/docs/quickstart/') },
];
---

<header class="nav">
	<div class="wrap bar">
		<a class="brand" href={href('/')} aria-label="cidx home">
			<svg viewBox="0 0 32 32" width="26" height="26" aria-hidden="true" fill="none">
				<path d="M10 10.5 21.5 16 10 21.5V10.5" stroke="var(--accent)" stroke-width="1.6" stroke-linejoin="round" opacity=".55"></path>
				<circle cx="10" cy="10.5" r="3" fill="var(--exact)"></circle>
				<circle cx="10" cy="21.5" r="3" fill="var(--name-only)"></circle>
				<circle cx="21.5" cy="16" r="3.6" fill="var(--accent)"></circle>
			</svg>
			<span>cidx</span>
		</a>
		<nav aria-label="Main">
			<ul>
				{links.map((link) => <li class:list={{ keep: link.label === 'Docs' }}><a href={link.to}>{link.label}</a></li>)}
			</ul>
		</nav>
		<div class="actions">
			<button class="theme" type="button" aria-label="Switch colour theme" data-theme-toggle>
				<svg class="sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
				<svg class="moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5a8.5 8.5 0 1 0 11 11Z"></path></svg>
			</button>
		</div>
	</div>
	<span class="progress" aria-hidden="true"></span>
</header>

<script>
	const root = document.documentElement;
	document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
		const next = root.dataset.theme === 'light' ? 'dark' : 'light';
		root.dataset.theme = next;
		localStorage.setItem('starlight-theme', next);
	});

	const header = document.querySelector('.nav');
	const progress = header?.querySelector<HTMLElement>('.progress');
	const onScroll = () => {
		header?.classList.toggle('scrolled', window.scrollY > 8);
		const range = document.documentElement.scrollHeight - innerHeight;
		progress?.style.setProperty('--progress', String(range > 0 ? window.scrollY / range : 0));
	};
	addEventListener('scroll', onScroll, { passive: true });
	onScroll();

	// highlight the nav link of the section in view
	const sectionLinks = new Map<Element, HTMLAnchorElement>();
	document.querySelectorAll<HTMLAnchorElement>('.nav nav a[href*="#"]').forEach((link) => {
		const section = document.getElementById(link.hash.slice(1));
		if (section) sectionLinks.set(section, link);
	});
	const spy = new IntersectionObserver(
		(entries) => {
			for (const entry of entries) {
				if (!entry.isIntersecting) continue;
				sectionLinks.forEach((link) => link.removeAttribute('aria-current'));
				sectionLinks.get(entry.target)?.setAttribute('aria-current', 'true');
			}
		},
		{ rootMargin: '-45% 0px -50% 0px' },
	);
	sectionLinks.forEach((_, section) => spy.observe(section));
</script>

<style>
	.nav {
		position: sticky;
		top: 0;
		z-index: 50;
		border-bottom: 1px solid transparent;
		/* a soft backdrop even at the top of the page, so links never sit on bare artwork */
		background: linear-gradient(to bottom, color-mix(in srgb, var(--bg) 88%, transparent), transparent);
		transition:
			background 0.25s,
			border-color 0.25s;
	}

	.nav.scrolled {
		background: color-mix(in srgb, var(--bg) 82%, transparent);
		backdrop-filter: blur(14px) saturate(1.4);
		border-bottom-color: var(--line);
	}

	.bar {
		display: flex;
		align-items: center;
		gap: 2rem;
		height: 4rem;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		font-family: var(--font-mono);
		font-weight: 600;
		font-size: 1.05rem;
		letter-spacing: -0.02em;
	}

	nav {
		margin-left: auto;
	}

	nav ul {
		display: flex;
		gap: 1.75rem;
		font-size: 0.9rem;
		color: var(--text-soft);
	}

	nav a {
		padding-block: 0.5rem;
		transition: color 0.15s;
	}

	nav a:hover,
	nav a[aria-current] {
		color: var(--text);
	}

	nav a[aria-current] {
		box-shadow: inset 0 -2px 0 var(--accent);
	}

	.progress {
		position: absolute;
		left: 0;
		right: 0;
		bottom: -1px;
		height: 2px;
		background: linear-gradient(to right, var(--exact), var(--accent));
		transform-origin: left;
		transform: scaleX(var(--progress, 0));
	}

	.actions {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}





	.theme {
		width: 2.25rem;
		height: 2.25rem;
		display: grid;
		place-items: center;
		border-radius: 999px;
		color: var(--text-soft);
	}

	.theme:hover {
		color: var(--text);
		background: var(--bg-raised);
	}

	.theme .sun,
	:global([data-theme='light']) .theme .moon {
		display: none;
	}

	:global([data-theme='light']) .theme .sun {
		display: block;
	}

	@media (max-width: 760px) {
		.bar {
			gap: 1rem;
		}
		nav li:not(.keep) {
			display: none;
		}
	}
</style>
