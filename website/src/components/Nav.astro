---
import { href, liveMeta, REPO_URL } from '../util/site';

const { stars } = await liveMeta();
const links = [
	{ label: 'Setup', to: href('/#connect') },
	{ label: 'Demo', to: href('/#demo') },
	{ label: 'How it works', to: href('/#how') },
	{ label: 'Benchmarks', to: href('/#numbers') },
	{ label: 'Docs', to: href('/docs/quickstart/') },
];
---

<header class="nav">
	<div class="wrap bar">
		<a class="brand" href={href('/')} aria-label="cidx home">
			<svg viewBox="0 0 32 32" width="26" height="26" aria-hidden="true" fill="none">
				<path d="M10 10.5 21.5 16 10 21.5V10.5" stroke="var(--accent)" stroke-width="1.6" stroke-linejoin="round" opacity=".55"></path>
				<circle cx="10" cy="10.5" r="3" fill="var(--exact)"></circle>
				<circle cx="10" cy="21.5" r="3" fill="var(--name-only)"></circle>
				<circle cx="21.5" cy="16" r="3.6" fill="var(--accent)"></circle>
			</svg>
			<span>cidx</span>
		</a>
		<nav aria-label="Main">
			<ul>
				{links.map((link) => <li class:list={{ keep: link.label === 'Docs' }}><a href={link.to}>{link.label}</a></li>)}
			</ul>
		</nav>
		<div class="actions">
			<a class="gh" href={REPO_URL} aria-label="cidx on GitHub">
				<svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" fill="currentColor">
					<path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"></path>
				</svg>
				<span>GitHub</span>
				<span class="count" data-live="stars" hidden={stars === null}>
					<svg viewBox="0 0 16 16" width="11" height="11" aria-hidden="true" fill="currentColor"><path d="M8 .25a.75.75 0 0 1 .67.42l1.88 3.82 4.21.61a.75.75 0 0 1 .42 1.28l-3.05 2.97.72 4.19a.75.75 0 0 1-1.09.79L8 12.35l-3.76 1.98a.75.75 0 0 1-1.09-.79l.72-4.19L.82 6.38a.75.75 0 0 1 .42-1.28l4.21-.61L7.33.67A.75.75 0 0 1 8 .25Z"></path></svg>
					<span data-live-value>{stars ?? ''}</span>
					<span class="sr-only">stars</span>
				</span>
			</a>
			<button class="theme" type="button" aria-label="Switch colour theme" data-theme-toggle>
				<svg class="sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
				<svg class="moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5a8.5 8.5 0 1 0 11 11Z"></path></svg>
			</button>
		</div>
	</div>
	<span class="progress" aria-hidden="true"></span>
</header>

<script>
	const root = document.documentElement;
	document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
		const next = root.dataset.theme === 'light' ? 'dark' : 'light';
		root.dataset.theme = next;
		localStorage.setItem('starlight-theme', next);
	});

	const header = document.querySelector('.nav');
	const progress = header?.querySelector<HTMLElement>('.progress');
	const onScroll = () => {
		header?.classList.toggle('scrolled', window.scrollY > 8);
		const range = document.documentElement.scrollHeight - innerHeight;
		progress?.style.setProperty('--progress', String(range > 0 ? window.scrollY / range : 0));
	};
	addEventListener('scroll', onScroll, { passive: true });
	onScroll();

	// highlight the nav link of the section in view
	const sectionLinks = new Map<Element, HTMLAnchorElement>();
	document.querySelectorAll<HTMLAnchorElement>('.nav nav a[href*="#"]').forEach((link) => {
		const section = document.getElementById(link.hash.slice(1));
		if (section) sectionLinks.set(section, link);
	});
	const spy = new IntersectionObserver(
		(entries) => {
			for (const entry of entries) {
				if (!entry.isIntersecting) continue;
				sectionLinks.forEach((link) => link.removeAttribute('aria-current'));
				sectionLinks.get(entry.target)?.setAttribute('aria-current', 'true');
			}
		},
		{ rootMargin: '-45% 0px -50% 0px' },
	);
	sectionLinks.forEach((_, section) => spy.observe(section));

	// Refresh the star count in the browser; the build-time value is the fallback.
	fetch('https://api.github.com/repos/gativarshney/cidx')
		.then((response) => (response.ok ? response.json() : null))
		.then((repo) => {
			if (typeof repo?.stargazers_count !== 'number') return;
			document.querySelectorAll<HTMLElement>('[data-live="stars"]').forEach((badge) => {
				badge.hidden = false;
				badge.querySelector('[data-live-value]')!.textContent = String(repo.stargazers_count);
			});
		})
		.catch(() => {});
</script>

<style>
	.nav {
		position: sticky;
		top: 0;
		z-index: 50;
		border-bottom: 1px solid transparent;
		transition:
			background 0.25s,
			border-color 0.25s;
	}

	.nav.scrolled {
		background: color-mix(in srgb, var(--bg) 82%, transparent);
		backdrop-filter: blur(14px) saturate(1.4);
		border-bottom-color: var(--line);
	}

	.bar {
		display: flex;
		align-items: center;
		gap: 2rem;
		height: 4rem;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		font-family: var(--font-mono);
		font-weight: 600;
		font-size: 1.05rem;
		letter-spacing: -0.02em;
	}

	nav {
		margin-left: auto;
	}

	nav ul {
		display: flex;
		gap: 1.75rem;
		font-size: 0.9rem;
		color: var(--text-soft);
	}

	nav a {
		padding-block: 0.5rem;
		transition: color 0.15s;
	}

	nav a:hover,
	nav a[aria-current] {
		color: var(--text);
	}

	nav a[aria-current] {
		box-shadow: inset 0 -2px 0 var(--accent);
	}

	.progress {
		position: absolute;
		left: 0;
		right: 0;
		bottom: -1px;
		height: 2px;
		background: linear-gradient(to right, var(--exact), var(--accent));
		transform-origin: left;
		transform: scaleX(var(--progress, 0));
	}

	.actions {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.gh {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		height: 2.25rem;
		padding-inline: 0.8rem;
		border: 1px solid var(--line-strong);
		border-radius: 999px;
		font-size: 0.85rem;
		font-weight: 500;
		transition:
			border-color 0.15s,
			background 0.15s;
	}

	.gh:hover {
		border-color: var(--accent);
		background: var(--bg-raised);
	}

	.count {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
		padding-left: 0.5rem;
		border-left: 1px solid var(--line-strong);
		font-family: var(--font-mono);
		font-size: 0.78rem;
		color: var(--text-soft);
	}

	.count[hidden] {
		display: none;
	}

	.theme {
		width: 2.25rem;
		height: 2.25rem;
		display: grid;
		place-items: center;
		border-radius: 999px;
		color: var(--text-soft);
	}

	.theme:hover {
		color: var(--text);
		background: var(--bg-raised);
	}

	.theme .sun,
	:global([data-theme='light']) .theme .moon {
		display: none;
	}

	:global([data-theme='light']) .theme .sun {
		display: block;
	}

	@media (max-width: 760px) {
		.bar {
			gap: 1rem;
		}
		nav li:not(.keep) {
			display: none;
		}
		.gh > span:first-of-type {
			display: none;
		}
	}
</style>
