---
const limits = [
	{ title: 'Two languages', text: 'Python and TypeScript/JavaScript only.' },
	{ title: 'No semantic search', text: 'Names and structure, not concepts.' },
	{ title: 'No type checker', text: 'Matches carry a confidence tag instead.' },
	{ title: 'TypeScript types are skipped', text: 'interface, type and enum are not indexed yet.' },
	{ title: 'Namespace imports', text: 'import * as x is not followed.' },
	{ title: 'Freshness cost grows', text: 'Each save re-resolves the whole index: about 1.5 s on Django.' },
];
---

<ul class="limits">
	{limits.map((limit, index) => (
		<li data-reveal data-glow style={`transition-delay: ${index * 50}ms`}>
			<h3>{limit.title}</h3>
			<p>{limit.text}</p>
		</li>
	))}
</ul>

<style>
	.limits {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		border: 1px solid var(--line);
		border-radius: 16px;
		overflow: hidden;
		background: var(--line);
		gap: 1px;
	}

	li {
		padding: 1.25rem;
		background: var(--bg);
	}

	h3 {
		font-size: 0.95rem;
		font-weight: 600;
		display: flex;
		align-items: center;
		gap: 0.55rem;
	}

	h3::before {
		content: '';
		flex: none;
		width: 0.7rem;
		height: 2px;
		background: var(--name-only);
	}

	p {
		margin-top: 0.4rem;
		font-size: 0.88rem;
		color: var(--muted);
	}

	@media (max-width: 900px) {
		.limits {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 560px) {
		.limits {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
